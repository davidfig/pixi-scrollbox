{
    "name": "pixi-scrollbox",
    "version": "3.0.0",
    "description": "a scrollbox built for pixi.js using a masked box that scrolls vertically and/or horizontally with optional scrollbars",
    "main": "./dist/scrollbox.js",
    "module": "./dist/scrollbox.mjs",
    "types": "./@types/index.d.ts",
    "exports": {
        ".": {
            "types": "./@types/index.d.ts",
            "import": "./dist/scrollbox.mjs",
            "require": "./dist/scrollbox.js"
        }
    },
    "packageManager": "pnpm@12.16.1",
    "directories": {
        "doc": "docs"
    },
    "files": [
        "dist",
        "@types"
    ],
    "scripts": {
        "dev": "vite --config vite.demo.mjs",
        "build": "vite build",
        "build-demo": "rm -rf docs/assets && vite build --config vite.demo.mjs",
        "docs": "jsdoc -c .jsdoc.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json",
        "upgrade": "pnpm update --interactive --latest",
        "prepublishOnly": "pnpm run build && pnpm run build-demo && pnpm run docs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/davidfig/pixi-scrollbox.git"
    },
    "keywords": [
        "PIXI",
        "pixi.js",
        "scrollbox",
        "UI"
    ],
    "author": "David Figatner",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/davidfig/pixi-scrollbox/issues"
    },
    "homepage": "https://github.com/davidfig/pixi-scrollbox#readme",
    "peerDependencies": {
        "pixi-viewport": "^7",
        "pixi.js": "^8"
    },
    "devDependencies": {
        "highlight.js": "11.12.0",
        "jsdoc": "4.0.5",
        "jsdom": "29.1.1",
        "penner": "0.1.3",
        "pixi-viewport": "7.0.0",
        "pixi.js": "8.22.0",
        "typescript": "5.9.3",
        "vite": "8.3.5",
        "vitest": "5.0.5",
        "yy-jsdoc-template": "1.3.0"
    }
}
